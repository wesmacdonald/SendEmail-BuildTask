{
    "compilerOptions": {
      "target": "es2019",
      "module": "commonjs",
      "outDir": "./",
      "rootDir": "./",
      "strict": false,
      "esModuleInterop": true,
      "skipLibCheck": true,
      "forceConsistentCasingInFileNames": true,
      "resolveJsonModule": true
    },
    "exclude": [
      "node_modules"
    ]
}